# HomeX Team Board — Supabase connection (SHARED with homex-backend-ticket).
#
# Copy this file to `.env.local` and paste the values from the SAME Supabase
# project the ticket app uses: Supabase dashboard -> Project Settings -> API.
#
# The publishable (anon) key is meant to be public; data security is enforced by
# Row Level Security + the team email allowlist, not by hiding this key. In CI,
# these are supplied as GitHub repository Variables of the same names.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
